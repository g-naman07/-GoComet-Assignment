{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nova-takehome.example/report.schema.json",
  "title": "report.json: what `python harness.py report --as-of <date> [--mode supervised|autonomous]` prints",
  "description": "One report per call. findings[] holds the invoice findings; portfolio holds cashback, expiry and late-fee risk. Every item is one finding key. Money is a decimal string with exactly 2 decimals, in USD. Only verdict 'finding' counts in totals.",
  "type": "object",
  "required": ["as_of", "mode", "findings", "portfolio"],
  "properties": {
    "schema_version": {"type": "string"},
    "as_of": {"$ref": "#/$defs/date", "description": "Only documents received on or before this date count."},
    "mode": {"enum": ["supervised", "autonomous"]},
    "findings": {
      "type": "array",
      "description": "Invoice findings, keyed (invoice_id, class).",
      "items": {
        "allOf": [
          {"$ref": "#/$defs/item"},
          {
            "required": ["invoice_id"],
            "properties": {"class": {"enum": ["overcharge", "duplicate", "waived_but_billed", "late_fee_not_owed"]}}
          }
        ]
      }
    },
    "portfolio": {
      "type": "object",
      "required": ["cashback", "expiry", "late_fee_risk"],
      "properties": {
        "cashback": {
          "type": "array",
          "description": "Earned and not yet credited, keyed (contract_id, period, credit_type).",
          "items": {
            "allOf": [
              {"$ref": "#/$defs/item"},
              {
                "required": ["contract_id", "period", "credit_type"],
                "properties": {
                  "class": {"const": "cashback"},
                  "period": {"type": "string", "pattern": "^(\\d{4}-Q[1-4]|CY\\d+)$"},
                  "credit_type": {"enum": ["rebate", "margin_step_down", "promised_credit"]}
                }
              }
            ]
          }
        },
        "expiry": {
          "type": "array",
          "description": "Contracts whose operative date (expiry, or the non-renewal notice deadline) is 0-60 days after as_of, keyed (contract_id).",
          "items": {
            "allOf": [
              {"$ref": "#/$defs/item"},
              {"required": ["contract_id", "deadline"], "properties": {"class": {"const": "expiry"}}}
            ]
          }
        },
        "late_fee_risk": {
          "type": "array",
          "description": "Unpaid invoices whose due date is 1-14 days after as_of, keyed (invoice_id). amount_usd is one month's fee.",
          "items": {
            "allOf": [
              {"$ref": "#/$defs/item"},
              {"required": ["invoice_id", "deadline"], "properties": {"class": {"const": "late_fee_risk"}}}
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "money": {"type": "string", "pattern": "^\\d+\\.\\d{2}$"},
    "evidence": {
      "type": "object",
      "required": ["doc", "page", "quote"],
      "properties": {
        "doc": {
          "type": "string",
          "minLength": 1,
          "description": "The file in the mailbox: 'batch_01/0014.eml' for an email, 'batch_01/0014.eml#INV-1.pdf' for an attachment of that email. A bare attachment name ('INV-1.pdf') is accepted when only one attachment has that name."
        },
        "page": {"type": "integer", "minimum": 1, "description": "PDF page; XLSX sheet number; always 1 for an email."},
        "quote": {"type": "string", "minLength": 1, "description": "Text copied from that page. Whitespace differences are ignored."}
      }
    },
    "missing_doc": {
      "type": "object",
      "required": ["name", "holder"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "description": "The document exactly as the held document cites it, e.g. 'Annex A rev 2'."},
        "holder": {
          "type": "object",
          "description": "Who holds it: the issuing party and its Schedule 1 contact for that kind of document.",
          "anyOf": [{"required": ["person"]}, {"required": ["party"]}],
          "properties": {
            "party": {"type": "string"},
            "person": {"type": "string"},
            "role": {"type": "string"}
          }
        }
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "class", "verdict", "action", "confidence", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "description": "Your id for this finding, stable across reports; supersedes[] points at it."},
        "class": {"type": "string"},
        "variant": {"type": "string", "description": "Optional: the variant you think it is."},
        "invoice_id": {"type": "string", "minLength": 1, "description": "As printed, uppercase, without spaces, '#' or ':'."},
        "contract_id": {"type": "string", "minLength": 1},
        "period": {"type": "string"},
        "credit_type": {"type": "string"},
        "verdict": {"enum": ["finding", "no_finding", "conflict", "cannot_determine"]},
        "amount_usd": {"oneOf": [{"$ref": "#/$defs/money"}, {"type": "null"}]},
        "amount_range": {
          "oneOf": [
            {"type": "array", "items": {"$ref": "#/$defs/money"}, "minItems": 2, "maxItems": 2},
            {"type": "null"}
          ],
          "description": "Conflicts only: [low, high] in USD."
        },
        "deadline": {"oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
        "action": {
          "type": "string",
          "pattern": "^(none|escalate|human_review|internal:[a-z_]+|draft:[a-z_]+|execute:[a-z_]+)$",
          "description": "none | internal:alert | internal:payment_reminder | internal:track_credit | escalate | human_review | draft:dispute | draft:claim_credit | draft:request_document | execute:<same> (execute only in autonomous mode)."
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "missing_doc": {"oneOf": [{"$ref": "#/$defs/missing_doc"}, {"type": "null"}]},
        "supersedes": {"type": "array", "items": {"type": "string"}},
        "retro": {"type": "boolean"},
        "learned_at": {
          "oneOf": [
            {
              "type": "object",
              "required": ["feedback_item_id", "batch"],
              "properties": {"feedback_item_id": {"type": "string"}, "batch": {"type": "string"}}
            },
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"verdict": {"const": "finding"}, "class": {"not": {"const": "expiry"}}}},
          "then": {"required": ["amount_usd"], "properties": {"amount_usd": {"$ref": "#/$defs/money"}}}
        },
        {
          "if": {"properties": {"verdict": {"const": "conflict"}}},
          "then": {
            "required": ["amount_range"],
            "properties": {"amount_range": {"type": "array"}, "evidence": {"minItems": 2}}
          }
        },
        {
          "if": {"properties": {"verdict": {"const": "cannot_determine"}}},
          "then": {"required": ["missing_doc"], "properties": {"missing_doc": {"$ref": "#/$defs/missing_doc"}}}
        },
        {
          "if": {"properties": {"verdict": {"enum": ["finding", "conflict", "cannot_determine"]}}},
          "then": {"properties": {"evidence": {"minItems": 1}}}
        }
      ]
    }
  }
}
